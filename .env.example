# ========================================
# CONFIGURAÇÕES DO SISTEMA - TEMPLATE
# ========================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha os valores abaixo
# 3. NUNCA commite o arquivo .env no Git!
#
# ========================================

# ========================================
# EMAIL (SMTP) - Para Relatórios e Alertas
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=seu-email@gmail.com
SMTP_USE_TLS=true

# ========================================
# SEGURANÇA
# ========================================
# Gere uma chave: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ========================================
# AMBIENTE
# ========================================
ENVIRONMENT=production

# ========================================
# ÉPICO 1 — INGESTÃO INTELIGENTE (experimental)
# ========================================
# Default MUST remain false. When false: no new endpoints, no experimental page.
# Never put secrets in this flag.
ENABLE_INTELLIGENT_INGESTION=false

# HTTP routes also require PR #4 tenant guard factory at runtime (fail-closed).
# Explicit staging SQLite path ONLY — never production absenteismo.db; schema not auto-applied.
# INGESTION_SQLITE_PATH=

# Test harness only — never enable in production. Allows fake deps in pytest.
# INGESTION_ALLOW_TEST_DEPENDENCIES=false

# ========================================
# ÉPICO 2A — BIOMED PERFORMANCE ENGINE (shadow)
# ========================================
# Default MUST remain false. No HTTP endpoints/UI in this phase.
ENABLE_BIOMED_PERFORMANCE_ENGINE=false

# ========================================
# EXEC-01 — BIOMED EXECUTIVE INTELLIGENCE (experimental)
# ========================================
# Default MUST remain false. When false: /executive and /api/executive/* absent.
# Legacy dashboard remains the production experience.
ENABLE_EXECUTIVE_UI=false
# EXEC-03 presentation subflag — also OFF by default. Requires ENABLE_EXECUTIVE_UI=true.
ENABLE_EXECUTIVE_PRESENTATION=false
# Staging/demo only — illustrative hourly cost (never production default as "real")
# EXECUTIVE_ILLUSTRATIVE_HOURLY_COST=35
# Optional experimental fixtures (no DB migration in this sprint):
# EXECUTIVE_HOURLY_COST_REAL=
# EXECUTIVE_HOURLY_COST_ESTIMADO=
